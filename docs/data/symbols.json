{"symbol":"ㄍ","ipa":"k","how":"k as in \"skin\".","error":"","notes":"","examples":[{"zh":"哥哥","zhuyin":"ㄍㄜ ˙ㄍㄜ","en":"older brother","id":"220000001","level":"第1級"},{"zh":"狗","zhuyin":"ㄍㄡˇ","en":"dog","id":"2259","level":"第2級"},{"zh":"水果","zhuyin":"ㄕㄨㄟˇ ㄍㄨㄛˇ","en":"fruit","id":"516300045","level":"第1*級"}],"audio":"juyin:ㄍ"},{"symbol":"ㄎ","ipa":"kʰ","how":"k plus a strong puff of air.","error":"Weak puff on ㄎ.","notes":"","examples":[{"zh":"可以","zhuyin":"ㄎㄜˇ ㄧˇ","en":"can; may","id":"250800042","level":"第1級"},{"zh":"咖啡","zhuyin":"ㄎㄚ ㄈㄟ","en":"coffee","id":"248800001","level":"第1級"},{"zh":"看","zhuyin":"ㄎㄢˋ","en":"to look; to watch","id":"2562","level":"第1級"}],"audio":"juyin:ㄎ"},{"symbol":"ㄏ","ipa":"x ~ h","how":"Light friction at the soft palate.","error":"A harsh \"loch\" scrape.","notes":"A lighter [h] is normal in Taiwan (this point is still uncertain).","examples":[{"zh":"很","zhuyin":"ㄏㄣˇ","en":"very","id":"2780","level":"第1級"},{"zh":"喝","zhuyin":"ㄏㄜ","en":"to drink","id":"2675","level":"第1級"},{"zh":"火車","zhuyin":"ㄏㄨㄛˇ ㄔㄜ","en":"train","id":"286100033","level":"第1*級"}],"audio":"juyin:ㄏ"},{"symbol":"ㄐ","ipa":"tɕ","how":"Tongue tip down behind the lower teeth, blade raised to the hard palate, lips spread as in a smile.","error":"English j with rounded lips.","notes":"","examples":[{"zh":"捷運","zhuyin":"ㄐㄧㄝˊ ㄩㄣˋ","en":"MRT (metro)","id":null,"level":"第3級"},{"zh":"機車","zhuyin":"ㄐㄧ ㄔㄜ","en":"scooter","id":"302000026","level":"第3級"},{"zh":"再見","zhuyin":"ㄗㄞˋ ㄐㄧㄢˋ","en":"goodbye","id":"532400008","level":"第1級"},{"zh":"今天","zhuyin":"ㄐㄧㄣ ㄊㄧㄢ","en":"today","id":"331800002","level":"第1級"}],"audio":"juyin:ㄐ"},{"symbol":"ㄑ","ipa":"tɕʰ","how":"Same position as ㄐ plus a strong puff of air, lips spread.","error":"English ch with rounded lips.","notes":"","examples":[{"zh":"請","zhuyin":"ㄑㄧㄥˇ","en":"please","id":"3742","level":"第1級"},{"zh":"錢","zhuyin":"ㄑㄧㄢˊ","en":"money","id":"3674","level":"第1級"},{"zh":"汽車","zhuyin":"ㄑㄧˋ ㄔㄜ","en":"car","id":"357500004","level":"第2級"},{"zh":"星期","z